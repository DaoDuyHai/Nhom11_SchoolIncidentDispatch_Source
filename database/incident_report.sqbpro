('ELECTRIC', 'Sự cố Điện nguy hiểm (Chập cầu dao, Rò điện)', 'TECHNICAL', 4, 300),
('MEDICAL', 'Cấp cứu Y tế (Học sinh ngất xỉu, Chấn thương)', 'MEDICAL', 5, 180),
('SECURITY', 'An ninh Trật tự (Xô xát, Người lạ đột nhập)', 'SECURITY', 4, 180),
